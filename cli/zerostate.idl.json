            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Proposal",
      "docs": [
        "A question put to the membership. Full text lives off-chain; the chain keeps",
        "a title and the hash that pins it. Tallies are weighted sums."
      ],
      "type": {
        "kind": "struct",
        "fields": [
