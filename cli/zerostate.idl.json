                64
              ]
            }
          }
        ]
      }
    },
    {
      "name": "Member",
      "docs": [
        "A member: a wallet that has mined. Created permissionlessly by `join`. Holds",
        "no weight field — weight is derived live from the member's frankcoin Proof at",
        "vote time (so it decays with inactivity without needing to be rewritten)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "joined_ts",
            "type": "i64"
          },
          {
            "name": "votes_cast",
            "type": "u64"
          }
        ]
      }
    },
